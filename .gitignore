# ============================================================
# .gitignore -- Q4 Day3 构建隔离规则
# ============================================================
# 不进 git 的内容分类:
#   - 运行时产物(每次跑会变)
#   - 构建产物(pyinstaller 生成)
#   - 缓存(Python 自动生成)

# --- 运行时产物(server_pro 跑时生成) ---
var/
*.pid
*.log

# --- 构建产物(pyinstaller) ---
dist/
build/
*.spec

# --- Python 缓存(import 时自动生成) ---
__pycache__/
*.pyc
*.pyo

# --- 编辑器/系统文件 ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
